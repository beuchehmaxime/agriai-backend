# Environment setup
NODE_ENV=development
PORT=3000

# Database
# e.g., postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Authentication
# e.g., a long random string used to sign JWTs
JWT_SECRET=

# External Services
# e.g., http://localhost:8007
ML_SERVICE_URL=
# Must match INTERNAL_API_KEY in the ML service's .env
ML_SERVICE_API_KEY=

# Claude (Anthropic) API
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5
ANTHROPIC_MODEL=

# Cloudinary Setup
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
